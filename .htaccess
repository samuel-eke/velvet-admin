<IfModule mod_rewrite.c>
  # Disable MultiViews (can interfere with SPA routing)
  Options -MultiViews

  RewriteEngine On
  RewriteBase /

  # If the request is for a real file or folder, serve it normally
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # For all other requests, serve index.html but keep the original URL
  # QSA preserves query strings (useful for uploads or tracking params)
  RewriteRule ^ /index.html [L,QSA]
</IfModule>

<IfModule mod_dir.c>
  # Ensure index.html is the directory index
  DirectoryIndex index.html
</IfModule>

<IfModule mod_headers.c>
  # Prevent aggressive caching of index.html so clients always get the app
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
